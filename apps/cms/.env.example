# apps/cms — Strapi 5 environment template.
#
# Copy to `apps/cms/.env` for local development. NEVER commit `.env`.
# Production values live in the Render dashboard, not in this repository
# (docs/adr/0002-cms.md decision 9, docs/ops/cms-runbook.md step 4).

# --- Server ---
HOST=0.0.0.0
PORT=1337
# Public URL of the website. Used for CORS and, later, editor preview.
CLIENT_URL=http://localhost:3000

# --- Strapi secrets ---
# Generate a fresh value per environment, never reuse across environments:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=replace-me-1,replace-me-2
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# --- Database ---
# Production MUST be the Neon POOLED connection string — the host contains "-pooler"
# (e.g. ep-xxx-pooler.eu-central-1.aws.neon.tech). Strapi opens more connections than
# Neon's direct endpoint tolerates.
# Production MUST NOT use Render Postgres — the free tier is deleted on a schedule.
# See docs/adr/0002-cms.md decision 4 and docs/ops/cms-runbook.md step 2.
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/strapi?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
#
# Local Postgres without TLS instead:
#   DATABASE_URL=postgresql://strapi:strapi@127.0.0.1:5432/strapi_dev
#   DATABASE_SSL=false

# --- Locales ---
# `en` is created on first boot; `tr` is seeded by src/index.ts. Codes are exactly
# `en` and `tr` (design/i18n.md) — never en-US / tr-TR.
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=en

# --- Media: Cloudflare R2 (S3-compatible) ---
# REQUIRED in production. If all four are unset in development, uploads fall back to
# local disk (apps/cms/public/uploads) — a develop-only convenience, never a deploy.
# ACL is intentionally not configurable — R2 does not support it.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=kuasar-media
R2_ACCESS_KEY_ID=
R2_ACCESS_SECRET=
# Public base URL when a custom domain is bound to the bucket (media.<DOMAIN>).
R2_PUBLIC_URL=
